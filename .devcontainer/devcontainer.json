{
  "name": "Jarvis browser preview",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Jarvis browser chat",
      "onAutoForward": "openBrowserOnce"
    }
  },
  "postAttachCommand": "python3 -m http.server 8000 --bind 0.0.0.0 --directory web"
}
